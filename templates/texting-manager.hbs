<div class="tm-body">

  <div class="tm-row">
    <label class="tm-label" for="tm-crystal-select">Crystal</label>
    <select id="tm-crystal-select" class="tm-select">
      {{#each crystalOptions}}
      <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>

  <div class="tm-columns">
    <div class="tm-contacts-col">
      <div class="tm-col-header">Granted Contacts</div>
      <div class="tm-checklist">
        {{#each contactChecklist}}
        <label class="tm-checklist-row">
          <input type="checkbox" class="tm-contact-checkbox" data-contact-id="{{this.id}}" {{#if this.granted}}checked{{/if}} />
          <span>{{this.name}}</span>
        </label>
        {{/each}}
        {{#unless contactChecklist.length}}
        <p class="hstl-empty">No other actors exist yet.</p>
        {{/unless}}
      </div>
    </div>

    <div class="tm-thread-col">
      <div class="tm-row">
        <label class="tm-label" for="tm-contact-select">Reply As</label>
        <select id="tm-contact-select" class="tm-select">
          <option value="">— Select a granted contact —</option>
          {{#each grantedContacts}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </div>

      {{#if selectedContactId}}
      <div class="tm-thread-scroll">
        {{#each thread}}
        <div class="tm-bubble-row {{#if this.fromContact}}tm-bubble-row-contact{{else}}tm-bubble-row-self{{/if}}">
          <div class="tm-bubble">
            <div class="tm-bubble-text">{{this.text}}</div>
            <div class="tm-bubble-time">{{this.timeDisplay}}</div>
          </div>
          <button type="button" class="tm-bubble-delete" data-action="deleteMessage" data-message-id="{{this.id}}" title="Delete message">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
        {{/each}}
        {{#unless thread.length}}
        <p class="hstl-empty">No messages yet.</p>
        {{/unless}}
      </div>

      <div class="tm-composer">
        <textarea name="tmMessage" class="tm-input" rows="2" placeholder="Reply as {{activeContactName}}..."></textarea>
        <button type="button" class="tm-send-btn" data-action="sendAsContact">
          <i class="fa-solid fa-paper-plane"></i>
        </button>
      </div>

      <details class="tm-import">
        <summary class="tm-import-summary">Import Conversation</summary>
        <p class="tm-import-hint">One message per line: <code>Crystal: text</code> or <code>Contact: text</code>. Anything else (blank lines, headers) is skipped.</p>
        <textarea name="tmImportScript" class="tm-import-input" rows="6" placeholder="Crystal: hey, is this the right number?&#10;Contact: Who told you to text this."></textarea>
        <div class="tm-import-row">
          <label class="tm-import-spread-label">
            Spread over last
            <input type="number" name="tmImportSpreadDays" class="tm-import-spread-input" min="0" value="0" />
            days (0 = all at once)
          </label>
          <label class="tm-import-replace-label">
            <input type="checkbox" name="tmImportReplace" />
            Replace existing thread
          </label>
        </div>
        <button type="button" class="tm-import-btn" data-action="importConversation">
          <i class="fa-solid fa-file-import"></i> Import
        </button>
      </details>
      {{else}}
      <p class="hstl-empty tm-thread-placeholder">Select a granted contact above to view or reply to that thread.</p>
      {{/if}}
    </div>
  </div>

</div>
